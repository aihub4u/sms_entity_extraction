# --- Server ---
PORT=3000
# If set, every /v1 call must send header  x-api-key: <value>
API_KEY=change-me

# --- OpenAI ---
OPENAI_API_KEY=sk-...
# Any vision-capable model that supports Structured Outputs (json_schema strict)
OPENAI_MODEL=gpt-5.4-mini
# Optional. Reasoning models: minimal | low | medium | high  (low is a good default for extraction)
OPENAI_REASONING_EFFORT=low
# Optional. Only for non-reasoning models (e.g. gpt-4.1-mini); leave blank for GPT-5.x
OPENAI_TEMPERATURE=
# Optional. Azure OpenAI / gateway / proxy base URL
OPENAI_BASE_URL=
OPENAI_TIMEOUT_MS=30000

# --- Business rules ---
TZ_NAME=Asia/Kolkata
# Fields that must be present before status=COMPLETE (subset of SBI's JSON_COMPLAIN_REQ fields)
REQUIRED_FIELDS=txnNo,amount,date,time,account_card_det,txnType
ESCALATION_AMOUNT_THRESHOLD=100000
MAX_TXN_AGE_DAYS=365
BANK_HELPLINE=1800111109

# --- SBI complaint API (leave blank for POC => mock acknowledgement) ---
SBI_COMPLAINT_API_URL=
SBI_COMPLAINT_API_KEY=

MAX_BODY_MB=8
